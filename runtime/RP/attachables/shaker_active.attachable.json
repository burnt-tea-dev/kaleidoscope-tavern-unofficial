{
  "format_version": "1.21.30",
  "minecraft:attachable": {
    "description": {
      "identifier": "kaleidoscope_tavern:shaker_active",
      "item": {
        "kaleidoscope_tavern:shaker_active": "q.is_owner_identifier_any('minecraft:player')"
      },
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/kaleidoscope_tavern/block/mixology/shaker",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.kt_mixology.shaker_hand_v27"
      },
      "animations": {
        "hold_first": "animation.kt_mixology.hold_first",
        "hold_third": "animation.kt_mixology.hold_third",
        "shake_first": "animation.kt_mixology.shake_first",
        "hold_first_left": "animation.kt_mixology.hold_first_left",
        "hold_third_left": "animation.kt_mixology.hold_third_left",
        "shake_first_left": "animation.kt_mixology.shake_first_left"
      },
      "scripts": {
        "animate": [
          {
            "hold_first": "c.item_slot != 'off_hand' && c.is_first_person && !(q.main_hand_item_use_duration > 0 && (q.main_hand_item_max_duration - q.main_hand_item_use_duration) <= 111)"
          },
          {
            "hold_third": "c.item_slot != 'off_hand' && !c.is_first_person"
          },
          {
            "shake_first": "c.item_slot != 'off_hand' && c.is_first_person && (q.main_hand_item_use_duration > 0 && (q.main_hand_item_max_duration - q.main_hand_item_use_duration) <= 111)"
          },
          {
            "hold_first_left": "c.item_slot == 'off_hand' && c.is_first_person && !(q.item_remaining_use_duration('off_hand') > 0 && q.item_remaining_use_duration('off_hand') >= 3594.45)"
          },
          {
            "hold_third_left": "c.item_slot == 'off_hand' && !c.is_first_person"
          },
          {
            "shake_first_left": "c.item_slot == 'off_hand' && c.is_first_person && (q.item_remaining_use_duration('off_hand') > 0 && q.item_remaining_use_duration('off_hand') >= 3594.45)"
          }
        ]
      },
      "render_controllers": [
        "controller.render.kt_mixology.held"
      ]
    }
  }
}
