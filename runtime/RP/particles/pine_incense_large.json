{
  "format_version": "1.10.0",
  "particle_effect": {
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_local_space": {
        "position": false,
        "rotation": false
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "facing_camera_mode": "lookat_xyz",
        "size": [
          "(variable.particle_random_2<0.5?0.05:0.075)*1",
          "(variable.particle_random_2<0.5?0.05:0.075)*1"
        ],
        "uv": {
          "texture_height": 9,
          "texture_width": 3,
          "uv": [
            0,
            "variable.kt_frame*3"
          ],
          "uv_size": [
            3,
            3
          ]
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          1
        ]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_initialization": {
        "per_render_expression": "loop(math.max(0,math.min(math.floor(variable.particle_age*20)+1,variable.kt_life)-variable.kt_tick), {variable.kt_oldx=variable.kt_x;variable.kt_oldy=variable.kt_y;variable.kt_oldz=variable.kt_z;variable.kt_oldroll=variable.kt_roll;variable.kt_wind=0.005*math.pow(math.min((variable.kt_tick+1)/300,1),1.25);variable.kt_dx=variable.kt_dx+(math.cos(variable.kt_angle)*variable.kt_wind);variable.kt_dz=variable.kt_dz+(math.sin(variable.kt_angle)*variable.kt_wind);variable.kt_dy=variable.kt_dy-(0.00075);variable.kt_rs=variable.kt_rs+(variable.kt_ra/20);variable.kt_roll=variable.kt_roll+(variable.kt_rs/20);variable.kt_x=variable.kt_x+(variable.kt_dx);variable.kt_y=variable.kt_y+(variable.kt_dy);variable.kt_z=variable.kt_z+(variable.kt_dz);variable.kt_tick=variable.kt_tick+(1);});"
      },
      "minecraft:particle_lifetime_events": {
        "creation_event": "kt_motion_init"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(300)/20"
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.075,
        "enabled": true,
        "expire_on_contact": true
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "variable.kt_oldx+(variable.kt_x-variable.kt_oldx)*math.mod(variable.particle_age*20,1)",
          "variable.kt_oldy+(variable.kt_y-variable.kt_oldy)*math.mod(variable.particle_age*20,1)",
          "variable.kt_oldz+(variable.kt_z-variable.kt_oldz)*math.mod(variable.particle_age*20,1)"
        ],
        "rotation": "variable.kt_oldroll+(variable.kt_roll-variable.kt_oldroll)*math.mod(variable.particle_age*20,1)"
      }
    },
    "description": {
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/kt_derived/a17/particle_pine_incense_large"
      },
      "identifier": "kt_assets_a17:pine_incense_large"
    },
    "events": {
      "kt_motion_init": {
        "expression": "variable.kt_tick=0;variable.kt_life=300;variable.kt_x=0;variable.kt_oldx=variable.kt_x;variable.kt_y=0;variable.kt_oldy=variable.kt_y;variable.kt_z=0;variable.kt_oldz=variable.kt_z;variable.kt_dx=0;variable.kt_dy=0;variable.kt_dz=0;variable.kt_roll=0;variable.kt_oldroll=0;variable.kt_angle=math.random(0,60);variable.kt_rs=math.random(0,1)<0.5?-30:30;variable.kt_ra=math.random(0,1)<0.5?-5:5;variable.kt_frame=math.floor(math.floor(math.random(0,12))*2/12);"
      }
    }
  }
}
