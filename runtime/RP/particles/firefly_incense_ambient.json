{
  "format_version": "1.10.0",
  "particle_effect": {
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.01
      },
      "minecraft:emitter_local_space": {
        "position": false,
        "rotation": false
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.kt_spawn_count"
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "facing_camera_mode": "lookat_xyz",
        "size": [
          "0.08+variable.particle_random_3*0.04",
          "0.08+variable.particle_random_3*0.04"
        ],
        "uv": {
          "texture_height": 8,
          "texture_width": 8,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "0.9*(0.6+0.4*math.sin(variable.kt_tick*(0.3+variable.particle_random_4*0.4)*57.29577951308232))*math.clamp((1-variable.kt_tick/(variable.particle_lifetime*20))*5,0,1)"
        ]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_initialization": {
        "per_render_expression": "loop(math.max(0,math.min(math.floor(variable.particle_age*20)+1,variable.particle_lifetime*20)-variable.kt_tick), {variable.kt_oldx=variable.kt_x;variable.kt_oldy=variable.kt_y;variable.kt_oldz=variable.kt_z;variable.kt_dx=variable.kt_dx+(math.random(-0.001,0.001));variable.kt_dz=variable.kt_dz+(math.random(-0.001,0.001));variable.kt_dy=variable.kt_dy+(math.random(-0.00025,0.00025));variable.kt_x=variable.kt_x+(variable.kt_dx);variable.kt_y=variable.kt_y+(variable.kt_dy);variable.kt_z=variable.kt_z+(variable.kt_dz);variable.kt_dx=variable.kt_dx*(0.96);variable.kt_dz=variable.kt_dz*(0.96);variable.kt_tick=variable.kt_tick+(1);});"
      },
      "minecraft:particle_lifetime_events": {
        "creation_event": "kt_motion_init"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(60+math.floor(variable.particle_random_1*40))/20"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "variable.kt_oldx+(variable.kt_x-variable.kt_oldx)*math.mod(variable.particle_age*20,1)",
          "variable.kt_oldy+(variable.kt_y-variable.kt_oldy)*math.mod(variable.particle_age*20,1)",
          "variable.kt_oldz+(variable.kt_z-variable.kt_oldz)*math.mod(variable.particle_age*20,1)"
        ]
      }
    },
    "description": {
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/kaleidoscope_tavern_jar/particle/firefly_large"
      },
      "identifier": "kt_assets_a17:firefly_incense_ambient"
    },
    "events": {
      "kt_motion_init": {
        "expression": "variable.kt_tick=0;variable.kt_x=math.random(-16,16);variable.kt_oldx=variable.kt_x;variable.kt_y=math.random(-0.67,4.66);variable.kt_oldy=variable.kt_y;variable.kt_z=math.random(-16,16);variable.kt_oldz=variable.kt_z;variable.kt_dx=0;variable.kt_dy=0;variable.kt_dz=0;"
      }
    }
  }
}
