{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "kt_assets_a17:water_tap_drip_child",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/kaleidoscope_tavern/particle/java_feedback"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.01
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:emitter_local_space": {
        "position": false,
        "rotation": false
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.kt_life/20"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.kt_size",
          "variable.kt_size"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 512,
          "texture_height": 512,
          "uv": [
            "(1)*32",
            192
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.2,
          0.3,
          1,
          1
        ]
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.kt_life=math.floor(64/(math.random(0,1)*0.8+0.2));variable.kt_size=(0.1+math.random(0,0.1));"
      },
      "minecraft:particle_lifetime_events": {
        "creation_event": "kt_init"
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.kt_age=math.floor(variable.particle_age*20);loop(math.max(0,math.min(variable.kt_age+1,variable.kt_life)-variable.kt_tick), {variable.kt_oldx=variable.kt_x;variable.kt_oldy=variable.kt_y;variable.kt_oldz=variable.kt_z;variable.kt_dy-=0.06;variable.kt_x+=variable.kt_dx;variable.kt_dx*=0.98;variable.kt_y+=variable.kt_dy;variable.kt_dy*=0.98;variable.kt_z+=variable.kt_dz;variable.kt_dz*=0.98;variable.kt_tick+=1;});"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "variable.kt_oldx+(variable.kt_x-variable.kt_oldx)*math.mod(variable.particle_age*20,1)",
          "variable.kt_oldy+(variable.kt_y-variable.kt_oldy)*math.mod(variable.particle_age*20,1)",
          "variable.kt_oldz+(variable.kt_z-variable.kt_oldz)*math.mod(variable.particle_age*20,1)"
        ]
      },
      "minecraft:particle_motion_collision": {
        "enabled": true,
        "collision_radius": 0.01,
        "coefficient_of_restitution": 0,
        "expire_on_contact": true
      }
    },
    "events": {
      "kt_init": {
        "expression": "variable.kt_tick=0;variable.kt_age=0;variable.kt_x=0;variable.kt_oldx=variable.kt_x;variable.kt_y=variable.kt_origin_y ?? 0;variable.kt_oldy=variable.kt_y;variable.kt_z=0;variable.kt_oldz=variable.kt_z;variable.kt_dx=0;variable.kt_dy=0;variable.kt_dz=0;"
      }
    }
  }
}
