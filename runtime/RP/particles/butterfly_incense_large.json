{
  "format_version": "1.10.0",
  "particle_effect": {
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_local_space": {
        "position": false,
        "rotation": false
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "facing_camera_mode": "lookat_xyz",
        "size": [
          "(0.1+variable.particle_random_2*0.1)*(0.6+variable.particle_random_3*0.6)",
          "(0.1+variable.particle_random_2*0.1)*(0.6+variable.particle_random_3*0.6)"
        ],
        "uv": {
          "texture_height": 21,
          "texture_width": 7,
          "uv": [
            0,
            "math.mod(math.floor(variable.particle_age*4),3)*7"
          ],
          "uv_size": [
            7,
            7
          ]
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          1
        ]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_initialization": {
        "per_render_expression": "loop(math.max(0,math.min(math.floor(variable.particle_age*20)+1,variable.kt_life)-variable.kt_tick), {variable.kt_oldx=variable.kt_x;variable.kt_oldy=variable.kt_y;variable.kt_oldz=variable.kt_z;variable.kt_dy-=0.0004;variable.kt_x+=variable.kt_dx;variable.kt_y+=variable.kt_dy;variable.kt_z+=variable.kt_dz;variable.kt_tick+=1;});"
      },
      "minecraft:particle_lifetime_events": {
        "creation_event": "kt_motion_init"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(500+math.floor(variable.particle_random_1*501))/20"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "variable.kt_oldx+(variable.kt_x-variable.kt_oldx)*math.mod(variable.particle_age*20,1)",
          "variable.kt_oldy+(variable.kt_y-variable.kt_oldy)*math.mod(variable.particle_age*20,1)",
          "variable.kt_oldz+(variable.kt_z-variable.kt_oldz)*math.mod(variable.particle_age*20,1)"
        ]
      }
    },
    "description": {
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/kt_derived/a17/particle_butterfly_incense_large"
      },
      "identifier": "kt_assets_a17:butterfly_incense_large"
    },
    "events": {
      "kt_motion_init": {
        "expression": "variable.kt_tick=0;variable.kt_life=500+math.floor(variable.particle_random_1*501);variable.kt_x=0;variable.kt_oldx=variable.kt_x;variable.kt_y=0;variable.kt_oldy=variable.kt_y;variable.kt_z=0;variable.kt_oldz=variable.kt_z;variable.kt_y-=0.125;variable.kt_oldy=variable.kt_y;variable.kt_dx=(0)+math.random(-0.4,0.4);variable.kt_dy=(-0.8)+math.random(-0.4,0.4);variable.kt_dz=(0)+math.random(-0.4,0.4);variable.kt_scale=(math.random(0,1)+math.random(0,1)+1)*0.06/math.max(0.000000000001,math.sqrt(variable.kt_dx*variable.kt_dx+variable.kt_dy*variable.kt_dy+variable.kt_dz*variable.kt_dz));variable.kt_dx*=variable.kt_scale;variable.kt_dy*=variable.kt_scale;variable.kt_dz*=variable.kt_scale;variable.kt_dy+=0.1;"
      }
    }
  }
}
