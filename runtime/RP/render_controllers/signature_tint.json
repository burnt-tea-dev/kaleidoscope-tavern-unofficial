{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.kt_assets_a17.signature_glass": {
      "geometry": "Geometry.glass",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.frames[math.mod(math.floor(q.life_time * 10), 6)]"
      ],
      "arrays": {
        "textures": {
          "Array.frames": [
            "Texture.frame_0",
            "Texture.frame_1",
            "Texture.frame_2",
            "Texture.frame_3",
            "Texture.frame_4",
            "Texture.frame_5"
          ]
        }
      }
    },
    "controller.render.kt_assets_a17.signature_tint": {
      "geometry": "Geometry.liquid",
      "materials": [
        {
          "*": "Material.liquid"
        }
      ],
      "textures": [
        "Array.frames[math.mod(math.floor(q.life_time * 10), 6)]"
      ],
      "color": {
        "r": "query.property('kt_art:red') / 255",
        "g": "query.property('kt_art:green') / 255",
        "b": "query.property('kt_art:blue') / 255",
        "a": 1
      },
      "arrays": {
        "textures": {
          "Array.frames": [
            "Texture.frame_0",
            "Texture.frame_1",
            "Texture.frame_2",
            "Texture.frame_3",
            "Texture.frame_4",
            "Texture.frame_5"
          ]
        }
      }
    }
  }
}
