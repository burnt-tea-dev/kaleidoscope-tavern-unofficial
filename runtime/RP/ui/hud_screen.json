{
  "namespace": "hud",
  "kt_family_empty": {
    "type": "panel",
    "size": [
      0,
      0
    ]
  },
  "root_panel": {
    "$kt_tavern_hud_root|default": "hud.kt_family_empty",
    "$kg_grilling_hud_root|default": "hud.kt_family_empty",
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "kt_family_tavern@$kt_tavern_hud_root": {}
          },
          {
            "kt_family_grilling@$kg_grilling_hud_root": {}
          }
        ]
      }
    ]
  },
  "hud_actionbar_text": {
    "$kt_family_actionbar_text": "$actionbar_text",
    "visible": "((($kt_family_actionbar_text - '§r§0§r§0') = $kt_family_actionbar_text) and (($kt_family_actionbar_text - '§r[KT] 1:§') = $kt_family_actionbar_text) and (($kt_family_actionbar_text - '§r[KT] §b') = $kt_family_actionbar_text) and (not (('%.4s' * $kt_family_actionbar_text) = '!js.')))"
  },
  "hud_actionbar_text/actionbar_message": {
    "$kt_family_actionbar_text": "$actionbar_text",
    "visible": "((($kt_family_actionbar_text - '§r§0§r§0') = $kt_family_actionbar_text) and (($kt_family_actionbar_text - '§r[KT] 1:§') = $kt_family_actionbar_text) and (($kt_family_actionbar_text - '§r[KT] §b') = $kt_family_actionbar_text) and (not (('%.4s' * $kt_family_actionbar_text) = '!js.')))"
  }
}
