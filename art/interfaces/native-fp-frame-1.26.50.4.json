  "native_animation_reference": {
    "source": "animations/player_firstperson.animation.json",
    "animations": {
      "animation.player.first_person.base_pose": {
        "loop": true,
        "bones": {
          "body": {
            "rotation": [
              "query.target_x_rotation",
              "query.target_y_rotation",
              0.0
            ]
          },
          "head": {
            "rotation": [
              "query.target_x_rotation",
              "query.target_y_rotation + 180",
              0.0
            ]
          }
        }
      },
      "animation.player.first_person.empty_hand": {
        "loop": true,
        "bones": {
          "rightarm": {
            "position": [
              13.5,
              -10.0,
              12.0
            ],
            "rotation": [
              "95.0 + variable.is_using_vr * 7.5",
              "-45.0 + variable.is_using_vr * 7.5",
              "115.0 + variable.is_using_vr * -2.5"
            ]
          },
          "rightitem": {
            "position": [
              0.0,
              "q.get_default_bone_pivot('rightarm',1) - q.get_default_bone_pivot('rightitem',1) - 7.0",
              "-q.get_default_bone_pivot('rightitem',2)"
            ]
          },
          "leftitem": {
            "position": [
              0.0,
              "q.get_default_bone_pivot('leftarm',1) - q.get_default_bone_pivot('leftitem',1) - 7.0",
              "-q.get_default_bone_pivot('leftitem',2)"
            ]
          }
        }
      },
      "animation.player.first_person.breathing_bob": {
        "loop": true,
        "override_previous_animation": false,
        "bones": {
          "rightitem": {
            "position": [
              0.0,
              "variable.bob_animation * math.sin(q.life_time * 45.0) * 0.5",
              0.0
            ]
          }
        }
      },
      "animation.player.first_person.walk": {
        "loop": true,
        "bones": {
          "leftarm": {
            "position": [
              "math.sin(-query.walk_distance * 180.0) * variable.hand_bob * 9.75",
              "-math.abs(math.cos(-query.walk_distance * 180.0)) * variable.hand_bob * 15.0 + variable.short_arm_offset_left",
              0.0
            ]
          },
          "rightarm": {
            "position": [
              "math.sin(-query.walk_distance * 180.0) * variable.hand_bob * 9.75",
              "-math.abs(math.cos(-query.walk_distance * 180.0)) * variable.hand_bob * 15.0 + variable.short_arm_offset_right",
              0.0
            ]
          }
        }
      }
    }
  },
  "native_controller_reference": {
    "source": "animation_controllers/player.animation_controllers.json",
    "controller": "controller.animation.player.root",
    "first_person_state": {
      "animations": [
        "first_person_base_pose",
        "first_person_breathing_bob",
        {
          "first_person_swap_item": "!query.blocking"
        },
        {
          "first_person_shield_block": "query.blocking"
        },
        {
          "first_person_attack_controller": "variable.attack_time > 0.0 && query.get_equipped_item_name != 'filled_map' && !variable.melee_spear_equipped"
        },
        {
          "first_person_empty_hand": "query.get_equipped_item_name(0, 1) != 'filled_map'"
        },
        {
          "first_person_walk": "variable.bob_animation"
        },
        {
          "first_person_map_controller": "query.get_equipped_item_name(0, 1) == 'filled_map' || query.get_equipped_item_name('off_hand') == 'filled_map'"
        },
        {
          "first_person_crossbow_equipped": "query.get_equipped_item_name == 'crossbow' && variable.item_use_normalized > 0.0 && variable.item_use_normalized < 1.0"
        },
        {
          "first_person_melee_spear_controller": "variable.melee_spear_equipped"
        }
      ],
      "transitions": [
        {
          "paperdoll": "variable.is_paperdoll"
        },
        {
          "map_player": "variable.map_face_icon"
        },
        {
          "third_person": "!variable.is_first_person"
        }
      ]
    }
  },
  "native_player_reference": {
    "source": "entity/player.entity.json",
    "geometry": {
      "default": "geometry.humanoid.custom",
      "cape": "geometry.cape"
    },
    "script_scale": "0.9375",
    "hand_bob_initialize_expression": "variable.hand_bob = 0.0;",
    "hand_bob_update_expression": "variable.hand_bob = query.life_time < 0.01 ? 0.0 : variable.hand_bob + ((query.is_on_ground && query.is_alive ? math.clamp(math.sqrt(math.pow(query.position_delta(0), 2.0) + math.pow(query.position_delta(2), 2.0)), 0.0, 0.1) : 0.0) - variable.hand_bob) * 0.02;"
  },
  "projection_source_bounds": {
    "units": "model_pixels_before_parent_or_renderer_scaling",
    "breathing_bob": {
      "bone": "rightitem",
      "position_source_expression": [
        0.0,
        "variable.bob_animation * math.sin(q.life_time * 45.0) * 0.5",
        0.0
      ],
      "absolute_y_bound_expression": "0.5 * abs(variable.bob_animation)",
      "conditional_boolean_bob_y_bounds": [
        -0.5,
        0.5
      ],
      "condition": "Numeric bounds assume variable.bob_animation is 0 or 1; this source does not assign its engine-provided value."
    },
    "walk": {
      "bone": "rightarm",
      "position_source_expression": [
        "math.sin(-query.walk_distance * 180.0) * variable.hand_bob * 9.75",
        "-math.abs(math.cos(-query.walk_distance * 180.0)) * variable.hand_bob * 15.0 + variable.short_arm_offset_right",
        0.0
      ],
      "x_bounds_expression": [
        "-9.75 * abs(variable.hand_bob)",
        "9.75 * abs(variable.hand_bob)"
      ],
      "y_bounds_expression": [
        "variable.short_arm_offset_right - 15.0 * variable.hand_bob",
        "variable.short_arm_offset_right"
      ],
      "y_bounds_condition": "variable.hand_bob >= 0",
      "hand_bob_bounds": [
        0.0,
        0.1
      ],
      "hand_bob_bounds_evidence": "The source initializes hand_bob to 0 and updates it by 0.02 toward a target clamped to [0,0.1], preserving that interval when this recurrence is used.",
      "conditional_x_bounds": [
        -0.975,
        0.975
      ],
      "conditional_y_delta_bounds": [
        -1.5,
        0.0
      ],
      "unresolved_short_arm_offset": "variable.short_arm_offset_right is referenced but not assigned by these pinned files."
    },
    "socket_pivot_algebra": {
      "right_item_y": "(rightItem.pivot.y - rightArm.pivot.y) + (rightArm.pivot.y - rightItem.pivot.y - 7.0) == -7.0",
      "right_item_z": "rightItem.pivot.z + (-rightItem.pivot.z) == 0.0",
      "right_item_x_in_reflected_basis": "rightArm.pivot.x - rightItem.pivot.x",
      "verified_wide_right_item_offset": [
        1,
        -7,
        0
      ]
    },
    "pitch_camera_invariant": "Applying the same rigid world transform W to cup M and view C preserves inverse(W*C)*(W*M) == inverse(C)*M. A test that rotates only the cup against a fixed camera is not a source-backed pitch acceptance test.",
    "pitch_source": "The source base_pose rotates body by query.target_x_rotation/query.target_y_rotation; rightItem inherits rightArm then body. Head also has its own base_pose rotation and must not be used as an unverified duplicate camera transform.",
    "framing_adapter_authority": "The port camera offsets and head-centered projection are explicit mathematical adapters, not Java-authored offsets or native client FOV/eye-offset evidence."
  },
  "skin_verification": {
    "verified_geometry": "Pinned geometry.humanoid.custom sample with 4-pixel-wide arm boxes and the exact hierarchy extracted above.",
    "sample_hierarchy_matches_armor_reference": true,
