  "conclusion": {
    "three_native_potion_carrier_supported_by_tested_legal_definitions": false,
    "reject_candidate": "storage_item alone does not create a usable native inventory; adding legal weight limits cannot hold three non-stackable potions",
    "activation": "Both detached ItemStacks and items retrieved from a real entity inventory fail without storage_weight_limit; adding bundle_interaction alone does not help",
    "clone": "Adding storage_weight_modifier with weight_in_storage_item 4 preserves the first potion in clone; food and use_modifiers were not the cause of clone loss",
    "capacity": "Every tested active container reports weightLimit 64; each Consume potion weighs 64, so the second and third setItem calls throw OverWeightLimit",
    "documented_max_weight_limit": 64,
    "weight_above_documented_max_tested": false,
    "player_bundle_interaction_acceptable_for_shaker": false,
    "clone_result_interpretation": "Clone retention is derived from cloneContents, not the first diagnostic optional-chaining independence flag: an empty clone is a failure",
    "release_boundary": "Do not describe this rejected candidate as preserving three complete native ingredients or as a passing server-restart gate"
